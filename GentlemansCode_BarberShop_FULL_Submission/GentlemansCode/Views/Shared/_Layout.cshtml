<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] — Gentleman's Code</title><meta name="description" content="Gentleman's Code is a premium Cape Town barber studio for modern cuts, fades and grooming."/><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">GC</span><span><strong>GENTLEMAN'S</strong><small>CODE BARBER STUDIO</small></span></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false" onclick="toggleMenu()">☰</button><nav id="mainNav"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Services" asp-action="Index">Services</a><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Home" asp-action="Contact">Contact</a><a class="nav-book" asp-controller="Booking" asp-action="Index">Book Now</a></nav></div></header>
<main>@RenderBody()</main>
<footer class="footer"><div class="container footer-grid"><div><div class="brand footer-brand"><span class="brand-mark">GC</span><span><strong>GENTLEMAN'S</strong><small>CODE BARBER STUDIO</small></span></div><p>Sharp cuts. Good conversation. Cape Town energy.</p></div><div><h4>Explore</h4><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Services" asp-action="Index">Services</a><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Booking" asp-action="Index">Book a chair</a></div><div><h4>Visit</h4><p>18 Bree Street<br/>Cape Town, 8001</p><p>Mon–Fri: 09:00–18:00<br/>Sat: 09:00–16:00<br/>Sun: Closed</p></div><div><h4>Connect</h4><a href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram ↗</a><a href="https://www.facebook.com/" target="_blank" rel="noopener">Facebook ↗</a><a href="mailto:hello@gentlemanscode.co.za">hello@gentlemanscode.co.za</a><a href="tel:+27211234567">+27 21 123 4567</a></div></div><div class="container footer-bottom"><span>© @DateTime.Now.Year Gentleman's Code Barber Studio</span><a asp-controller="Home" asp-action="Terms">Terms & Conditions</a></div></footer>
<div id="welcomeModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-card"><button class="modal-close" onclick="closeWelcome()" aria-label="Close">×</button><span class="eyebrow">FIRST VISIT</span><h2 id="modalTitle">Welcome to the Code.</h2><p>New to the studio? Book your first cut and enjoy a complimentary hot towel finish.</p><a class="btn btn-primary" asp-controller="Booking" asp-action="Index" onclick="closeWelcome()">Book my chair</a></div></div>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
