@model BookingConfirmationViewModel
@{ ViewData["Title"]="Booking Confirmed"; }
<section class="confirmation section"><div class="container narrow"><div class="success-icon">✓</div><span class="eyebrow">BOOKING CONFIRMED</span><h1>You're in the <em>chair.</em></h1><p class="lead">Thanks, @Model.Booking.CustomerName. Your appointment is confirmed.</p><div class="confirmation-card"><div><span>DATE</span><strong>@Model.Booking.AppointmentDate.ToString("dddd, d MMMM yyyy")</strong></div><div><span>TIME</span><strong>@Model.Booking.AppointmentTime.ToString(@"hh\:mm")</strong></div><div><span>SERVICE</span><strong>@Model.Booking.Service!.Name</strong></div><div><span>BARBER</span><strong>@Model.Booking.Barber!.FullName</strong></div><div><span>LOCATION</span><strong>18 Bree Street, Cape Town</strong></div></div><div class="calendar-box"><h2>Add it to your calendar</h2><p>Use Google Calendar or download an Apple Calendar-compatible .ics event. Both use your selected appointment details.</p><div class="hero-actions"><a class="btn btn-primary" href="@Model.GoogleCalendarUrl" target="_blank" rel="noopener">Google Calendar ↗</a><a class="btn btn-outline" href="@Model.IcsUrl">Apple Calendar / .ics</a></div></div><a class="text-link" asp-controller="Home" asp-action="Index">← Back to home</a></div></section>
