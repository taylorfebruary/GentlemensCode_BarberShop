@model BookingViewModel
@{ ViewData["Title"]="Book Now"; }
<section class="page-hero booking-head"><div class="container"><span class="eyebrow">RESERVE YOUR CHAIR</span><h1>Make it <em>official.</em></h1><p>Choose your service, barber and time. We'll take care of the rest.</p></div></section>
<section class="section booking-section"><div class="container booking-layout"><div class="booking-info"><span class="eyebrow">HOW IT WORKS</span><h2>Three steps.<br/>One sharp appointment.</h2><div class="steps"><div><b>01</b><span>Choose your service</span></div><div><b>02</b><span>Pick your barber & time</span></div><div><b>03</b><span>Confirm & add to calendar</span></div></div><p class="small-note">Appointments are available Monday–Saturday during studio hours. Your selected slot is checked before confirmation.</p></div><form class="booking-form" asp-action="Index" method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-section"><span class="form-step">01</span><h3>Your appointment</h3><div class="field-grid"><label>Service<select asp-for="ServiceId"><option value="">Select a service</option>@foreach(var s in Model.Services){<option value="@s.ServiceId">@s.Name — R@s.Price</option>}</select></label><label>Barber<select asp-for="BarberId"><option value="">Choose your barber</option>@foreach(var b in Model.Barbers){<option value="@b.BarberId">@b.FullName — @b.Specialty</option>}</select></label><label>Date<input asp-for="AppointmentDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")"/></label><label>Time<select asp-for="AppointmentTime"><option>09:00</option><option>09:30</option><option>10:00</option><option>10:30</option><option>11:00</option><option>11:30</option><option>12:00</option><option>12:30</option><option>13:00</option><option>13:30</option><option>14:00</option><option>14:30</option><option>15:00</option><option>15:30</option><option>16:00</option><option>16:30</option><option>17:00</option></select></label></div></div><div class="form-section"><span class="form-step">02</span><h3>Your details</h3><div class="field-grid"><label>Full name<input asp-for="CustomerName" placeholder="Your name"/></label><label>Email address<input asp-for="CustomerEmail" placeholder="you@example.com"/></label><label>Phone number<input asp-for="CustomerPhone" placeholder="+27..."/></label><label class="full">Anything we should know? <textarea asp-for="Notes" rows="3" placeholder="Optional notes or requests"></textarea></label></div></div><button class="btn btn-primary submit-btn" type="submit">Confirm appointment <span>→</span></button><p class="privacy-note">By booking, you agree to our <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a>.</p></form></div></section>

