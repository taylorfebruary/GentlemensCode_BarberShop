@model IEnumerable<Service>
@{ ViewData["Title"]="Services"; }
<section class="page-hero"><div class="container"><span class="eyebrow">THE MENU</span><h1>Services & <em>pricing.</em></h1><p>Thoughtful grooming, transparent pricing and no rushed appointments.</p></div></section><section class="section"><div class="container"><div class="service-list">@foreach(var s in Model){<article class="service-row"><div class="service-number">@s.ServiceId.ToString("00")</div><div class="service-main"><h2>@s.Name</h2><p>@s.Description</p></div><div class="service-meta"><span>@s.DurationMinutes min</span><strong>R@s.Price</strong></div></article>}</div><div class="center-cta"><p>Not sure what to choose? Book a consultation and we'll guide you.</p><a class="btn btn-primary" asp-controller="Booking" asp-action="Index">Book now →</a></div></div></section>
